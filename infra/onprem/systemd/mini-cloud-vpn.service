# Bring the GCP PoC tunnel back after a reboot. strongswan-starter only starts
# charon from ipsec.conf, so nothing loads /etc/swanctl/swanctl.conf at boot,
# and ipsec0 is not persistent either. This loads the config (start_action =
# start initiates the tunnel) and recreates ipsec0 before FRR brings up BGP.
#
# Install: sudo infra/onprem/install-boot-unit.sh
# Override the uplink NIC: systemctl edit mini-cloud-vpn -> Environment=WAN_IF=enp1s0

[Unit]
Description=mini-cloud GCP PoC VPN (load swanctl config, create ipsec0)
Wants=network-online.target
After=network-online.target strongswan-starter.service
Requires=strongswan-starter.service
Before=frr.service

[Service]
Type=oneshot
RemainAfterExit=yes
# charon's vici socket appears shortly after strongswan-starter reports started.
ExecStartPre=/bin/sh -c 'for i in $(seq 1 30); do [ -S /run/charon.vici ] && exit 0; sleep 1; done; echo "charon vici socket not up" >&2; exit 1'
ExecStartPre=/usr/sbin/swanctl --load-all
ExecStart=/usr/local/sbin/mini-cloud-ipsec-xfrm.sh
ExecStop=/sbin/ip link del ipsec0
ExecStop=-/usr/sbin/nft delete table ip mini_cloud_vpn

[Install]
WantedBy=multi-user.target
